# Environment variables for O-Banking.
#
# Nothing loads this file automatically -- there is no dotenv dependency. Copy
# it, or just export these in your shell / virtualenv activation script.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# Required whenever DJANGO_DEBUG is off. The app refuses to start without it.
DJANGO_SECRET_KEY=

# Local development switch. "1" enables debug error pages and lets Django serve
# /static/ and /media/ itself. Leave it unset (off) for anything public.
# NOTE: with this off, runserver serves no static files until you run
# collectstatic, so set it to 1 while developing.
DJANGO_DEBUG=1

# Comma-separated hostnames. Defaults to localhost,127.0.0.1,[::1] when unset,
# which is enough for local development. Any real hostname must be listed.
DJANGO_ALLOWED_HOSTS=
